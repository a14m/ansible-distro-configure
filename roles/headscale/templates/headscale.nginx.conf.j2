server {
    listen 80;
    listen [::]:80;

    server_name {{ headscale_hostname }};

    location / {
        proxy_pass http://{{ network_ipv4_address }}:{{ headscale_port }};
        # headscale's control protocol upgrades a POST to WebSocket - nginx
        # doesn't forward Upgrade/Connection by default, unlike Caddy.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
    }
}
