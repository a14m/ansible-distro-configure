[Unit]
Description=Sonarr
After=network-online.target
Wants=network-online.target

[Service]
User=sonarr
Group={{ sonarr_group }}
# Group-writable files, so other services in the group can import and clean up
UMask=0002
Type=simple
ExecStart=/opt/Sonarr/Sonarr -nobrowser -data=/var/lib/sonarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
