[Unit]
Description=Radarr
After=network-online.target
Wants=network-online.target

[Service]
User=radarr
Group={{ radarr_group }}
# Group-writable files, so other services in the group can import and clean up
UMask=0002
Type=simple
ExecStart=/opt/Radarr/Radarr -nobrowser -data=/var/lib/radarr
TimeoutStopSec=20
KillMode=process
Restart=on-failure

[Install]
WantedBy=multi-user.target
