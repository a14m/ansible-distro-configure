[Unit]
Description=Prometheus exporter for Proxmox VE
After=network-online.target pveproxy.service
Wants=network-online.target

[Service]
ExecStart={{ prometheus_pve_exporter_install_dir }}/bin/pve_exporter \
    --config.file /etc/prometheus-pve-exporter.yml \
    --web.listen-address 0.0.0.0:{{ prometheus_pve_exporter_port }}
User=prometheus-pve-exporter
Group=prometheus-pve-exporter
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true

[Install]
WantedBy=multi-user.target
