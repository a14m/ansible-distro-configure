# vim: set filetype=hyprlang.ansible :

general {
    lock_cmd = pidof hyprlock || hyprlock
    before_sleep_cmd = loginctl lock-session
    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({action = "on"})'
}

# Lock
listener {
    timeout = {{ hyprland_idle_lock_timeout }}
    on-timeout = loginctl lock-session
}

# Screen off
listener {
    timeout = {{ hyprland_idle_dpms_timeout }}
    on-timeout = hyprctl dispatch 'hl.dsp.dpms({action = "off"})'
    on-resume = hyprctl dispatch 'hl.dsp.dpms({action = "on"})'
}

# Suspend (waits for active ssh connections to close)
listener {
    timeout = {{ hyprland_idle_suspend_timeout }}
    on-timeout = /etc/hypr/scripts/idle.sh --suspend
    on-resume = /etc/hypr/scripts/idle.sh --cancel
}
