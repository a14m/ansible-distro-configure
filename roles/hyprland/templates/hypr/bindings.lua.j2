-- Configure Hyprland Bindings
--
-- See https://wiki.hypr.land/Configuring/Keywords/
-- See https://wiki.hypr.land/Configuring/Binds/

hl.bind("SUPER + Q", hl.dsp.window.close(), { description = "Quit active window" })
hl.bind("SUPER + CTRL + Q", hl.dsp.exec_cmd("hyprlock"), { description = "Lock System" })
hl.bind("SUPER + SHIFT + Q", hl.dsp.exit(), { description = "Logout" })

-- Launcher
hl.bind("SUPER + SPACE", hl.dsp.exec_cmd("uwsm app -- $(tofi-drun)"), { description = "App Launcher" })

-- Clipboard managers
hl.bind("SUPER + C", hl.dsp.send_shortcut({ mods = "CTRL", key = "INSERT" }), { description = "MacOS Copy" })
hl.bind("SUPER + V", hl.dsp.send_shortcut({ mods = "SHIFT", key = "INSERT" }), { description = "MacOS Paste" })
hl.bind("SUPER + X", hl.dsp.send_shortcut({ mods = "CTRL", key = "X" }), { description = "MacOS Cut" })
hl.bind(
  "SUPER + SHIFT + V", hl.dsp.exec_cmd("alacritty --class work.kartoffln.clipse -e 'clipse'"),
  { description = "Clipboard Manager" }
)

-- Switch workspaces with ctrl + [0-9] (MacOS-like)
hl.bind("CTRL + 1", hl.dsp.focus({ workspace = 1 }), { description = "Switch to workspace 1" })
hl.bind("CTRL + 2", hl.dsp.focus({ workspace = 2 }), { description = "Switch to workspace 2" })
hl.bind("CTRL + 3", hl.dsp.focus({ workspace = 3 }), { description = "Switch to workspace 3" })
hl.bind("CTRL + 4", hl.dsp.focus({ workspace = 4 }), { description = "Switch to workspace 4" })
hl.bind("CTRL + 5", hl.dsp.focus({ workspace = 5 }), { description = "Switch to workspace 5" })
hl.bind("CTRL + 6", hl.dsp.focus({ workspace = 6 }), { description = "Switch to workspace 6" })
hl.bind("CTRL + 7", hl.dsp.focus({ workspace = 7 }), { description = "Switch to workspace 7" })
hl.bind("CTRL + 8", hl.dsp.focus({ workspace = 8 }), { description = "Switch to workspace 8" })
hl.bind("CTRL + 9", hl.dsp.focus({ workspace = 9 }), { description = "Switch to workspace 9" })

-- Move active window to a workspace with ctrl + SHIFT + [1-9]
hl.bind("CTRL + SHIFT + 1", hl.dsp.window.move({ workspace = 1 }),
  { description = "Move active window to workspace 1" })
hl.bind("CTRL + SHIFT + 2", hl.dsp.window.move({ workspace = 2 }),
  { description = "Move active window to workspace 2" })
hl.bind("CTRL + SHIFT + 3", hl.dsp.window.move({ workspace = 3 }),
  { description = "Move active window to workspace 3" })
hl.bind("CTRL + SHIFT + 4", hl.dsp.window.move({ workspace = 4 }),
  { description = "Move active window to workspace 4" })
hl.bind("CTRL + SHIFT + 5", hl.dsp.window.move({ workspace = 5 }),
  { description = "Move active window to workspace 5" })
hl.bind("CTRL + SHIFT + 6", hl.dsp.window.move({ workspace = 6 }),
  { description = "Move active window to workspace 6" })
hl.bind("CTRL + SHIFT + 7", hl.dsp.window.move({ workspace = 7 }),
  { description = "Move active window to workspace 7" })
hl.bind("CTRL + SHIFT + 8", hl.dsp.window.move({ workspace = 8 }),
  { description = "Move active window to workspace 8" })
hl.bind("CTRL + SHIFT + 9", hl.dsp.window.move({ workspace = 9 }),
  { description = "Move active window to workspace 9" })

-- Move/resize windows with mouse (SUPER + SHIFT + left/right click)
hl.bind("SUPER + SHIFT + mouse:272", hl.dsp.window.drag(), { mouse = true, description = "Move window with mouse" })
hl.bind("SUPER + SHIFT + mouse:273", hl.dsp.window.resize(), { mouse = true, description = "Move window with mouse" })

-- Cycle windows (alt-tab style) with SUPER + TAB
hl.bind("SUPER + TAB", hl.dsp.window.cycle_next({ next = true }), { description = "Cycle to next window" })
hl.bind("SUPER + SHIFT + TAB", hl.dsp.window.cycle_next({ next = false }), { description = "Cycle to previous window" })

-- Move focus with (SUPER + h/j/k/l)
hl.bind("SUPER + h", hl.dsp.focus({ direction = "left" }), { description = "Move focus left" })
hl.bind("SUPER + j", hl.dsp.focus({ direction = "down" }), { description = "Move focus down" })
hl.bind("SUPER + k", hl.dsp.focus({ direction = "up" }), { description = "Move focus up" })
hl.bind("SUPER + l", hl.dsp.focus({ direction = "right" }), { description = "Move focus right" })

-- Move windows within workspace with (SUPER + SHIFT + h/j/k/l)
hl.bind("SUPER + SHIFT + h", hl.dsp.window.move({ direction = "left" }), { description = "Move window left" })
hl.bind("SUPER + SHIFT + j", hl.dsp.window.move({ direction = "down" }), { description = "Move window down" })
hl.bind("SUPER + SHIFT + k", hl.dsp.window.move({ direction = "up" }), { description = "Move window up" })
hl.bind("SUPER + SHIFT + l", hl.dsp.window.move({ direction = "right" }), { description = "Move window right" })

-- Resize windows with (SUPER + CONTROL + h/j/k/l)
hl.bind("SUPER + CONTROL + h", hl.dsp.window.resize({ x = -20, y = 0, relative = true }),
  { repeating = true, description = "Resize window left" })
hl.bind("SUPER + CONTROL + j", hl.dsp.window.resize({ x = 0, y = 20, relative = true }),
  { repeating = true, description = "Resize window down" })
hl.bind("SUPER + CONTROL + k", hl.dsp.window.resize({ x = 0, y = -20, relative = true }),
  { repeating = true, description = "Resize window up" })
hl.bind("SUPER + CONTROL + l", hl.dsp.window.resize({ x = 20, y = 0, relative = true }),
  { repeating = true, description = "Resize window right" })

-- Laptop multimedia keys for volume and LCD brightness
hl.bind("XF86AudioRaiseVolume", hl.dsp.exec_cmd("/etc/hypr/scripts/volume.sh --inc 1"),
  { locked = true, repeating = true, description = "Increase volume" })
hl.bind("XF86AudioLowerVolume", hl.dsp.exec_cmd("/etc/hypr/scripts/volume.sh --dec 1"),
  { locked = true, repeating = true, description = "Decrease volume" })
hl.bind("XF86AudioMute", hl.dsp.exec_cmd("/etc/hypr/scripts/volume.sh --toggle-mute-vol"),
  { locked = true, repeating = true, description = "Toggle mute volume" })
hl.bind("XF86AudioMicMute", hl.dsp.exec_cmd("/etc/hypr/scripts/volume.sh --toggle-mute-mic"),
  { locked = true, repeating = true, description = "Toggle mute microphone" })
hl.bind("XF86MonBrightnessUp", hl.dsp.exec_cmd("/etc/hypr/scripts/brightness.sh --inc 5"),
  { locked = true, repeating = true, description = "Increase brightness" })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("/etc/hypr/scripts/brightness.sh --dec 5"),
  { locked = true, repeating = true, description = "Decrease brightness" })

-- Requires playerctl
hl.bind("XF86AudioNext", hl.dsp.exec_cmd("playerctl next"), { locked = true, description = "Next track" })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true, description = "Play/Pause track" })
hl.bind("XF86AudioPlay", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true, description = "Play/Pause track" })
hl.bind("XF86AudioPrev", hl.dsp.exec_cmd("playerctl previous"), { locked = true, description = "Previous track" })

-- Screenshot
hl.bind("SUPER + SHIFT + 3", hl.dsp.exec_cmd("/etc/hypr/scripts/screenshot.sh --window"),
  { description = "Screenshot window" })
hl.bind("SUPER + SHIFT + 4", hl.dsp.exec_cmd("/etc/hypr/scripts/screenshot.sh --region"),
  { description = "Screenshot region" })
