prometheus_config_file="/etc/prometheus/prometheus.yml"
prometheus_storage_path="/var/lib/prometheus"
prometheus_retention_time="{{ prometheus_retention }}"
prometheus_args="--web.listen-address={{ prometheus_host }}:{{ prometheus_port }}"
# NOTE: wait for prometheus to exit on stop, otherwise a restart respawns against the still bound port
retry="TERM/60/KILL/5"
