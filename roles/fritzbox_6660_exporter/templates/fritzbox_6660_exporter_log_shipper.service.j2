[Unit]
Description=Ship AVM Fritz!Box event log to a local log file
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/fritzbox_6660_exporter.env
ExecStart=/usr/bin/python3 {{ fritzbox_6660_exporter_install_dir }}/fritzbox_log_shipper.py \
    --gateway-url {{ fritzbox_6660_exporter_gateway_url }} \
    --log-file {{ fritzbox_6660_exporter_log_file }} \
    --state-file {{ fritzbox_6660_exporter_log_state_file }}
User=fritzbox_6660_exporter
Group=fritzbox_6660_exporter
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ fritzbox_6660_exporter_log_dir }}
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
