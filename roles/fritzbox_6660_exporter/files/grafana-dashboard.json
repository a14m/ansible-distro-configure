    },
    {
      "type": "timeseries",
      "title": "Uncorrectable codewords /s",
      "description": "Must be ~0. Sustained non-zero = data lost on the cable segment - screenshot with timestamps and open an ISP ticket.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
