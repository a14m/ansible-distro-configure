    {
      "type": "timeseries",
      "title": "Upstream power per channel",
      "description": "SC-QAM target 35..50 dBmV. Above ~53 the modem is at its transmit limit and upstream will start dropping - that's an ISP plant problem (bad tap/amp).",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
