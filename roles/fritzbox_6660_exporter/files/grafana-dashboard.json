{
  "title": "Fritz!Box Cable",
  "uid": "fritzbox-cable",
  "tags": [
    "fritzbox",
    "network",
    "isp",
    "docsis"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "WAN / cable link",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Cable link",
      "description": "DOCSIS physical link to the CMTS. Down here = ISP side, full stop.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_connection_status{connection=\"Physical Link\",interface=\"WAN\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Link flaps (24h)",
      "description": "Physical-link state changes in 24h. Non-zero = the cable link dropped.",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "changes(gateway_connection_status{connection=\"Physical Link\",interface=\"WAN\"}[24h])",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Provisioned down",
      "description": "Rate the CMTS grants you. A step down = ISP re-provisioned or the line degraded.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_max_bitrate{direction=\"Down\",interface=\"WAN\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Provisioned up",
      "description": "",
      "gridPos": {
        "x": 13,
        "y": 1,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_max_bitrate{direction=\"Up\",interface=\"WAN\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "FritzBox uptime",
      "description": "Box uptime. If this didn't reset during an incident, the box didn't reboot.",
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calc": "lastNotNull",
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_uptime_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Throughput",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "WAN throughput",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_traffic_rate{direction=\"Received\",interface=\"WAN\",unit=\"Bytes\"} * 8",
          "legendFormat": "down",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_traffic_rate{direction=\"Sent\",interface=\"WAN\",unit=\"Bytes\"} * 8",
          "legendFormat": "up",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "WAN utilisation vs provisioned rate",
      "description": "Pinned at 1.0 = you're just saturating the line (normal). Low utilisation with problems = look past the FritzBox.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_traffic_rate{direction=\"Received\",interface=\"WAN\",unit=\"Bytes\"} * 8 / on() gateway_max_bitrate{direction=\"Down\",interface=\"WAN\"}",
          "legendFormat": "down",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_traffic_rate{direction=\"Sent\",interface=\"WAN\",unit=\"Bytes\"} * 8 / on() gateway_max_bitrate{direction=\"Up\",interface=\"WAN\"}",
          "legendFormat": "up",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "DOCSIS downstream (ISP line quality)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Downstream power per channel",
      "description": "Healthy ~0 dBmV, roughly -7..+7. Channels drifting apart or out of band = line fault.",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dBmV",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": -7
              },
              {
                "color": "green",
                "value": -5
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_cable_power_downstream",
          "legendFormat": "{{frequency}} MHz",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "gateway_cable_power_downstream31",
          "legendFormat": "OFDM {{frequency}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Downstream MSE per channel",
      "description": "Modulation error (dB, MORE NEGATIVE = better; think MER = -MSE). Rising toward 0 / above -30 = noise on the segment.",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
