#!/usr/bin/env python3

"""Keep Cloudflare A/AAAA records pointed at this host's WAN addresses.

The IPv4 is read from the Fritz!Box itself over TR-064 (avoid using curl -4
ifconfig.co - wrong IP when VPN is on). IPv6 has no NAT to hide behind, so
it's read straight off this host's own interface instead.
"""

import ipaddress
import json
import os
import re
import sys
import urllib.error
import urllib.parse
import urllib.request

TTL = {{ cloudflare_ddns_ttl }}

SOAP_URI = "/upnp/control/wanipconnection1"
SOAP_ACTION = "urn:dslforum-org:service:WANIPConnection:1#GetExternalIPAddress"
# AVM's TR-064 uses the dslforum-org namespace/control path, not the generic
# UPnP IGD one (urn:schemas-upnp-org:service:WANIPConnection:1).
SOAP_BODY = b"""<?xml version="1.0" encoding="utf-8"?>
<s:Envelope xmlns:s="http://schemas.xmlsoap.org/soap/envelope/" s:encodingStyle="http://schemas.xmlsoap.org/soap/encoding/">
  <s:Body>
    <u:GetExternalIPAddress xmlns:u="urn:dslforum-org:service:WANIPConnection:1"/>
  </s:Body>
</s:Envelope>"""


def get_ipv4(fritzbox_url, username, password):
    password_mgr = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    password_mgr.add_password(None, fritzbox_url, username, password)
    opener = urllib.request.build_opener(urllib.request.HTTPDigestAuthHandler(password_mgr))
    request = urllib.request.Request(
        fritzbox_url + SOAP_URI,
        data=SOAP_BODY,
        method="POST",
        headers={
            "Content-Type": 'text/xml; charset="utf-8"',
            "SOAPAction": SOAP_ACTION,
        },
    )
    with opener.open(request, timeout=10) as response:
        body = response.read().decode()

    match = re.search(r"<NewExternalIPAddress>(.*?)</NewExternalIPAddress>", body)
    if not match:
        sys.exit(f"Could not read WAN IP from Fritz!Box TR-064 response: {body}")
    return match.group(1)


def get_ipv6(interface):
    if not interface:
        return None
    with open("/proc/net/if_inet6") as f:
        for line in f:
            addr_hex, _ifindex, _prefixlen, scope, _flags, ifname = line.split()
            if ifname == interface and scope == "00":  # scope 00 = global
                return str(ipaddress.IPv6Address(bytes.fromhex(addr_hex)))
    sys.exit(f"No global IPv6 address found on {interface}")


class CloudflareDNS:
    def __init__(self, zone_id, api_token, record_name, ttl):
        self.zone_id = zone_id
        self.api_token = api_token
        self.record_name = record_name
        self.ttl = ttl

    def _request(self, method, path, data=None):
        url = f"https://api.cloudflare.com/client/v4/zones/{self.zone_id}/dns_records{path}"
        headers = {
            "Authorization": f"Bearer {self.api_token}",
            "Content-Type": "application/json",
        }
        body = json.dumps(data).encode() if data is not None else None
        request = urllib.request.Request(url, data=body, method=method, headers=headers)
        with urllib.request.urlopen(request, timeout=10) as response:
            return json.load(response)

    def sync(self, record_type, desired_value):
        """PATCH record_type's content to desired_value if it has drifted. Never creates.

        No-op if desired_value is None (e.g. AAAA sync left unconfigured).
        """
        if desired_value is None:
            return
        query = urllib.parse.urlencode({"type": record_type, "name": self.record_name})
        result = self._request("GET", f"?{query}")
        records = result.get("result") or []
        if not records:
            print(f"No {record_type} record for {self.record_name}, skipping")
            return
        record_id, current_value = records[0]["id"], records[0]["content"]

        # Compare via ipaddress, not raw strings - Cloudflare stores IPv6 compressed,
        # which won't string-match an expanded /proc/net/if_inet6 address.
        if ipaddress.ip_address(desired_value) == ipaddress.ip_address(current_value):
            print(f"{record_type} unchanged ({desired_value}), skipping update")
            return

        # proxied is always forced false: an orange-clouded record breaks
        # anything needing raw TCP/WebSocket to this host (e.g. headscale), so
        # this role never assumes proxied is meant to stay on.
        update = self._request(
            "PATCH",
            f"/{record_id}",
            {
                "type": record_type,
                "name": self.record_name,
                "content": desired_value,
                "ttl": self.ttl,
                "proxied": False,
            },
        )
        if not update.get("success"):
            sys.exit(f"Cloudflare update failed: {update}")

        print(f"Updated {self.record_name} ({record_type}) to {desired_value}")


def main():
    cloudflare = CloudflareDNS(
        zone_id=os.environ["CLOUDFLARE_DDNS_ZONE_ID"],
        api_token=os.environ["CLOUDFLARE_DDNS_API_TOKEN"],
        record_name=os.environ["CLOUDFLARE_DDNS_RECORD_NAME"],
        ttl=TTL,
    )

    ipv4 = get_ipv4(os.environ["FRITZBOX_URL"], os.environ["FRITZBOX_USERNAME"], os.environ["FRITZBOX_PASSWORD"])
    cloudflare.sync("A", ipv4)

    ipv6 = get_ipv6(os.environ.get("CLOUDFLARE_DDNS_IPV6_INTERFACE", ""))
    cloudflare.sync("AAAA", ipv6)


if __name__ == "__main__":
    try:
        main()
    except urllib.error.HTTPError as e:
        sys.exit(f"HTTP {e.code} from {e.url}: {e.read().decode(errors='replace')}")
    except urllib.error.URLError as e:
        sys.exit(f"Request failed: {e.reason}")
