[connection]
id={{ network_wifi_ssid }}
uuid={{ network_wifi_ssid | to_uuid }}
type=wifi
autoconnect=true

[wifi]
mode=infrastructure
ssid={{ network_wifi_ssid }}

[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk={{ network_wifi_pass }}

[ipv4]
{% if network_ipv4_address is defined %}
method=manual
addresses={{ network_ipv4_address }}/{{ network_ipv4_prefix | default(24) }}
gateway={{ network_ipv4_gateway }}
{% if network_ipv4_dns is defined %}
dns={{ network_ipv4_dns }}
{% endif %}
{% else %}
method=auto
{% endif %}

[ipv6]
method=disabled

[proxy]
