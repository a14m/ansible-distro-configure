---
# Disable wifi connection on PVE, it's connected with LAN
network_wifi_ssid: ""
network_wifi_pass: ""
network_ipv4_address: "10.0.0.250"
network_ipv4_gateway: "10.0.0.254"
network_ipv4_dns: "10.0.0.254"
network_bridge_interface: "eth0"

# Generate with: ssh-keygen -t ed25519 -f host_key -C '' -N ''
ssh_public_key: "ssh-ed25519 AAAA...fMo"
ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  b3BlbnNzaC1r..........................................................
  ......................................................................
  ...................BAgME
  -----END OPENSSH PRIVATE KEY-----

pve_admin_user: "admin"
pve_admin_password: "changeme"
pve_storage_device: "/dev/sda4"

restic_version: "0.19.0"

ethtool_wol_interface: "eth0"
logind_lid_ac_action: "ignore"

# 8006 is Proxmox's default web UI port, not templated anywhere in this repo.
# Restricted to admin workstations rather than the whole LAN.
ufw_rules:
  - rule: "allow"
    port: "{{ ssh_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.0/24"
  - rule: "allow"
    port: 8006
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.201"
  - rule: "allow"
    port: 8006
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.203"
  - rule: "allow"
    port: 8006
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.202"
  - rule: "allow"
    port: "{{ node_exporter_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.106"
