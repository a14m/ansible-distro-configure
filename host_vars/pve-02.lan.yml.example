---
# Disable wifi connection on PVE, it's connected with LAN
network_wifi_ssid: ""
network_wifi_pass: ""
network_ipv4_address: "10.0.0.249"
network_ipv4_gateway: "10.0.0.254"
network_ipv4_dns: "10.0.0.254"
network_bridge_interface: "eth0"
network_ipv6_method: "auto"

# ssh-keygen -t ed25519 -f host_key -C '' -N ''
ssh_public_key: "ssh-ed25519 AAAA...fMo"
ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  b3BlbnNzaC1r..........................................................
  ......................................................................
  ...................BAgME
  -----END OPENSSH PRIVATE KEY-----

pve_admin_user: "admin"
pve_admin_password: "changeme"
pve_storage_device: "/dev/sda4"
pve_storage_volumes:
  # Shared /data for downloads, media and streaming; fixed size so a full library cannot fill the thin pool
  - name: "media"
    size: "300g"
    type: "ext4"
  - name: "data"
    size: "100%FREE"
    type: "lvmthin"

mount_device: "/dev/vmdata/media"
mount_point: "/srv/data"
mount_options: "defaults,noatime,nofail"
mount_owner: "100000"   # root inside the unprivileged containers
mount_group: "102000"   # the containers' shared "media" group (GID 2000)
mount_mode: "2775"      # setgid: new files keep the media group

# LC_ALL=C tr -dc 'A-Za-z0-9!#%+,-./:=?@^_~' < /dev/urandom | head -c 32; echo
prometheus_pve_exporter_password: "changeme"

restic_version: "0.19.0"

ethtool_wol_interface: "eth0"
logind_lid_ac_action: "ignore"

ufw_enabled: true
ufw_rules:
  - rule: "allow"
    port: "{{ ssh_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.0/24"
  - rule: "allow"
    port: 8006
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.0/24"
  - rule: "allow"
    port: "{{ node_exporter_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.106"
  - rule: "allow"
    port: "{{ prometheus_pve_exporter_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.106"
