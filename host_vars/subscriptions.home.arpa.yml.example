---
network_ipv4_address: "10.0.0.108"
network_ipv4_gateway: "10.0.0.254"
network_ipv4_dns: "10.0.0.254"

pve_lxc_id: 108
pve_lxc_hostname: "subscriptions"
# pve_lxc_template: "debian-13-standard_13.6-1_amd64.tar.zst"
pve_lxc_template: "alpine-3.23-default_20260116_amd64.tar.xz"
pve_lxc_disk: "local-lvm:4" # storage:sizeGB
pve_lxc_cores: 1
pve_lxc_memory: 512
pve_lxc_ip: "{{ network_ipv4_address }}/24"
pve_lxc_gateway: "{{ network_ipv4_gateway }}"
pve_lxc_dns: "{{ network_ipv4_dns }}"
# Note: The following config is required for systemd systems (debian, ubuntu, etc.) to run inside LXC.
# Alpine does not require it.
# pve_lxc_raw_config: |
  # features: nesting=1
pve_lxc_ssh_port: 2222
pve_lxc_ssh_public_key: "ssh-ed25519 AAAA...fMo"
pve_lxc_ssh_private_key: |
      -----BEGIN OPENSSH PRIVATE KEY-----
      b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
      QyNTUxOQAAACAQ0GydCVLVXnXpzBxM6MbmRIDHNjC8dqZoFHgx1PiSgQAAAJi7TmCqu05g
      qgAAAAtzc2gtZWQyNTUxOQAAACAQ0GydCVLVXnXpzBxM6MbmRIDHNjC8dqZoFHgx1PiSgQ
      AAAEBgO+cOwV2j8gNZ/EugDk+vbi0eGrK125vRcE3FOtJJMRDQbJ0JUtVedenMHEzoxuZE
      gMc2MLx2pmgUeDHU+JKBAAAAEm1vbGVjdWxlLXRlc3Qtb25seQECAw==
      -----END OPENSSH PRIVATE KEY-----

wallos_hostname: "subscriptions.internal"
wallos_main_currency: "EUR"
wallos_language: "en"
# wallos_admin bootstraps Wallos's sole account. Plaintext is unavoidable here
# — Wallos hashes server-side on registration, there's no way to pre-hash it.
# Add further accounts by hand through the web UI.
wallos_admin:
  username: "admin"
  email: "admin@example.com"
  password: "changeme"

# Excludes sendverificationemails (polls for nothing, no verification flow to gate
# since accounts are provisioned directly) and generaterecommendations weekly/monthly
# (sends subscription data to an external AI API).
wallos_jobs:
  - name: "updatenextpayment"
    script: "updatenextpayment.php"
    cron_schedule: "0 1 * * *"
    systemd_schedule: "*-*-* 01:00:00"
  - name: "checkforupdates"
    script: "checkforupdates.php"
    cron_schedule: "0 */6 * * *"
    systemd_schedule: "*-*-* 0/6:00:00"
  - name: "storetotalyearlycost"
    script: "storetotalyearlycost.php"
    cron_schedule: "30 1 * * 1"
    systemd_schedule: "Mon *-*-* 01:30:00"
  - name: "cleanupresettokens"
    script: "cleanupresettokens.php"
    cron_schedule: "0 3 * * *"
    systemd_schedule: "*-*-* 03:00:00"

backup_name: "subscriptions"
backup_paths:
  - "{{ wallos_install_dir }}/db"
  - "{{ wallos_install_dir }}/images/uploads/logos"
backup_cron_schedule: "0 0 * * 0"
backup_systemd_schedule: "Sun *-*-*"
backup_repo: "s3:http://10.0.0.254:3900/backups"
backup_s3_region: "garage"
backup_access_key_id: "GK_CHANGEME"
backup_secret_access_key: "CHANGEME"
backup_password: "changeme"

# Only needed on Alpine (to scrape cron logs) — journal auto-scrape covers this on systemd
alloy_file_scrape_targets:
  - name: "wallos"
    path: "/var/log/wallos/*.log"
  - name: "subscriptions-backup"
    path: "/var/log/subscriptions-backup.log"

ufw_rules:
  - rule: "allow"
    port: "{{ ssh_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.0/24"
  - rule: "allow"
    port: "{{ wallos_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['proxy.home.arpa'].network_ipv4_address }}"
