---
network_ipv4_address: "10.0.0.121"
network_ipv4_gateway: "10.0.0.254"
network_ipv4_dns: "10.0.0.254"

pve_lxc_node: "pve-02.lan"
pve_lxc_id: 121
pve_lxc_hostname: "downloads"
pve_lxc_template: "debian-13-standard_13.6-1_amd64.tar.zst"
pve_lxc_disk: "local-lvm:4" # storage:sizeGB
pve_lxc_cores: 2
pve_lxc_memory: 1024
pve_lxc_mac: "BC:24:11:00:00:0B"
pve_lxc_ip: "{{ network_ipv4_address }}/24"
pve_lxc_gateway: "{{ network_ipv4_gateway }}"
pve_lxc_dns: "{{ network_ipv4_dns }}"
pve_lxc_configs:
  - "features: nesting=1"
  - "mp0: /srv/data,mp=/data"   # shared media volume
# DNS comes only from the VPN (systemd-resolved); PVE should not overwrite /etc/resolv.conf in the container
pve_lxc_ignore_resolv_conf: true
pve_lxc_ssh_port: 2222
# ssh-keygen -t ed25519 -f host_key -C '' -N ''
pve_lxc_ssh_public_key: "ssh-ed25519 AAAA...fMo"
pve_lxc_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
  QyNTUxOQAAACAQ0GydCVLVXnXpzBxM6MbmRIDHNjC8dqZoFHgx1PiSgQAAAJi7TmCqu05g
  qgAAAAtzc2gtZWQyNTUxOQAAACAQ0GydCVLVXnXpzBxM6MbmRIDHNjC8dqZoFHgx1PiSgQ
  AAAEBgO+cOwV2j8gNZ/EugDk+vbi0eGrK125vRcE3FOtJJMRDQbJ0JUtVedenMHEzoxuZE
  gMc2MLx2pmgUeDHU+JKBAAAAEm1vbGVjdWxlLXRlc3Qtb25seQECAw==
  -----END OPENSSH PRIVATE KEY-----

wireguard_autostart_connection: "wg-vpn"
wireguard_connections:
  wg-vpn: |
    [Interface]
    PrivateKey = your_private_key_here
    Address = 10.2.0.2/32
    DNS = 10.2.0.1

    [Peer]
    PublicKey = server_public_key
    AllowedIPs = 0.0.0.0/0
    Endpoint = 100.0.0.113:51820

qbittorrent_username: "alice"
qbittorrent_password: "CHANGEME"
qbittorrent_hostname: "downloads.internal"
qbittorrent_vpn_connection: "wg-vpn"
qbittorrent_save_path: "/data/torrents"
qbittorrent_group: "media"
qbittorrent_group_id: 2000   # same GID in every container sharing /data (102000 on the host)
qbittorrent_max_ratio: 1     # stop seeding at ratio 1

prowlarr_hostname: "search.internal"
prowlarr_allowed_hosts:
  - "{{ prowlarr_hostname }}"         # through the proxy
  - "{{ network_ipv4_address }}"      # Sonarr/Radarr/Homarr connect directly
prowlarr_api_key: "CHANGEME"
qbittorrent_trusted_proxy: "{{ hostvars['proxy.home.arpa'].network_ipv4_address }}"

# Kill switch: all egress is denied except through the tunnel and to its endpoint (must match Endpoint above)
ufw_default_outgoing_policy: "deny"
ufw_rules:
  - rule: "allow"
    port: "{{ ssh_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.0/24"
  - rule: "allow"
    protocol: "any"
    direction: "out"
    interface: "wg-vpn"
  - rule: "allow"
    port: 51820
    protocol: "udp"
    direction: "out"
    to: "100.0.0.113"
  - rule: "allow"
    port: "{{ qbittorrent_webui_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['proxy.home.arpa'].network_ipv4_address }}"
  - rule: "allow"
    port: "{{ prowlarr_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['proxy.home.arpa'].network_ipv4_address }}"
# Sonarr/Radarr (in media) use qBittorrent and Prowlarr; Prowlarr pushes its indexers back to them
  - rule: "allow"
    port: "{{ qbittorrent_webui_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['media.home.arpa'].network_ipv4_address }}"
  - rule: "allow"
    port: "{{ prowlarr_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['media.home.arpa'].network_ipv4_address }}"
  - rule: "allow"
    port: 8989   # sonarr
    protocol: "tcp"
    direction: "out"
    to: "{{ hostvars['media.home.arpa'].network_ipv4_address }}"
  - rule: "allow"
    port: 7878   # radarr
    protocol: "tcp"
    direction: "out"
    to: "{{ hostvars['media.home.arpa'].network_ipv4_address }}"
