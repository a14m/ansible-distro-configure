---
network_ipv4_address: "10.0.0.123"
network_ipv4_gateway: "10.0.0.254"
network_ipv4_dns: "10.0.0.254"

pve_lxc_node: "pve-02.lan"
pve_lxc_id: 123
pve_lxc_hostname: "streaming"
pve_lxc_template: "debian-13-standard_13.6-1_amd64.tar.zst"
pve_lxc_disk: "local-lvm:8" # storage:sizeGB (metadata, images and cache)
pve_lxc_cores: 2
pve_lxc_memory: 2048
pve_lxc_mac: "BC:24:11:00:00:0D"
pve_lxc_ip: "{{ network_ipv4_address }}/24"
pve_lxc_gateway: "{{ network_ipv4_gateway }}"
pve_lxc_dns: "{{ network_ipv4_dns }}"
pve_lxc_configs:
  - "features: nesting=1"
  - "mp0: /srv/data,mp=/data,ro=1"   # shared media volume, read-only: Jellyfin can't change or delete media
pve_lxc_ssh_port: 39901
pve_lxc_ssh_public_key: "ssh-ed25519 AAAA...fMo"
pve_lxc_ssh_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  b3BlbnNzaC1rZXktdjEAAAAABG5vbmUAAAAEbm9uZQAAAAAAAAABAAAAMwAAAAtzc2gtZW
  QyNTUxOQAAACAQ0GydCVLVXnXpzBxM6MbmRIDHNjC8dqZoFHgx1PiSgQAAAJi7TmCqu05g
  qgAAAAtzc2gtZWQyNTUxOQAAACAQ0GydCVLVXnXpzBxM6MbmRIDHNjC8dqZoFHgx1PiSgQ
  AAAEBgO+cOwV2j8gNZ/EugDk+vbi0eGrK125vRcE3FOtJJMRDQbJ0JUtVedenMHEzoxuZE
  gMc2MLx2pmgUeDHU+JKBAAAAEm1vbGVjdWxlLXRlc3Qtb25seQECAw==
  -----END OPENSSH PRIVATE KEY-----

jellyfin_hostname: "streaming.internal"
jellyfin_local_networks:
  - "10.0.0.0/24"   # the LAN; Tailscale clients arrive from the subnet router's LAN IP
jellyfin_known_proxies:
  - "{{ hostvars['proxy.home.arpa'].network_ipv4_address }}"
jellyfin_server_name: "Jellyfin"
jellyfin_users:   # initial passwords, change them in the web UI
  - { name: "alice", password: "CHANGEME", admin: true }   # first admin: the setup admin
  - { name: "bob", password: "CHANGEME", admin: true }
  - { name: "kids", password: "CHANGEME" }
jellyfin_metadata_language: "en"
jellyfin_metadata_country: "DE"
jellyfin_libraries:
  - { name: "Movies", type: "movies", path: "/data/media/movies" }
  - { name: "Shows", type: "tvshows", path: "/data/media/tv" }

jellyfin_plugins:
  - name: "Moonbase"   # Moonfin apps' server plugin: settings sync, Seerr in the TV app
    url: "https://github.com/Moonfin-Client/Plugin/releases/download/3.1.0/Moonfin.Server-3.1.0.0.zip"
    config: "Moonfin.Server"
    settings:
      - { key: "SeerrEnabled", value: "true" }
      - { key: "SeerrUrl", value: "http://{{ hostvars['requests.home.arpa'].network_ipv4_address }}:5055" }

backup_name: "streaming"
backup_service: "jellyfin"   # stopped during an in-place restore
backup_paths:
  - "/etc/jellyfin"
  - "/var/lib/jellyfin"
backup_paths_exclude:
  - "/var/lib/jellyfin/metadata"   # artwork, re-fetched on a library scan
backup_cron_schedule: "0 4 * * 0"
backup_systemd_schedule: "Sun *-*-* 04:00"
backup_repo: "s3:http://10.0.0.254:3900/backups"
backup_s3_region: "garage"
backup_access_key_id: "GK_CHANGEME"
backup_secret_access_key: "CHANGEME"
backup_password: "changeme"

ufw_rules:
  - rule: "allow"
    port: "{{ ssh_port }}"
    protocol: "tcp"
    direction: "in"
    from: "10.0.0.0/24"
  - rule: "allow"
    port: "{{ jellyfin_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['proxy.home.arpa'].network_ipv4_address }}"
# Seerr (in requests) reads the libraries and signs users in
  - rule: "allow"
    port: "{{ jellyfin_port }}"
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['requests.home.arpa'].network_ipv4_address }}"
  - rule: "allow"
    port: 9100   # node-exporter, scraped by Prometheus
    protocol: "tcp"
    direction: "in"
    from: "{{ hostvars['metrics.home.arpa'].network_ipv4_address }}"
